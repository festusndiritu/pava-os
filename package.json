{
  "name": "pava-hardware",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:api": "cd apps/api && bun run start:dev",
    "dev:web": "cd apps/web && bun run dev",
    "prisma:migrate": "cd apps/api && bun run prisma:migrate",
    "prisma:seed": "cd apps/api && bun run prisma:seed"
  },
  "dependencies": {
    "@nestjs/swagger": "^12.0.1"
  }
}
