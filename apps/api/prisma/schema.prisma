generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Module {
  DASHBOARD
  POS
  PRODUCTS
  INVENTORY
  CUSTOMERS
  QUOTES
  INVOICES
  CONTACTS
  LEADS
  MARKETING
  HR
  PAYROLL
  EXPENSES
  REPORTS
  ANALYTICS
  AUDIT
  USERS
  SETTINGS
}

enum StockStatus {
  IN_STOCK
  SUPPLIER_ONLY
  OUT_OF_STOCK
}

enum DocumentType {
  QUOTE
  INVOICE
  RECEIPT
  DELIVERY_NOTE
}

enum DocumentStatus {
  DRAFT
  QUOTED
  INVOICED
  PAID
  CANCELLED
  // A POS order the operator parked to serve someone else. Carries no
  // document number, consumes no stock, and is either resumed into a real
  // sale or discarded — it never becomes a quote.
  SUSPENDED
}

enum TransportMode {
  NONE
  ITEMIZED
  DISTRIBUTED
}

// PAVA takes M-Pesa Paybill and cash at the till; CREDIT is an account sale
// raised through the quote -> invoice flow, not a till payment method. CARD
// is retained only so historical documents/expenses that already reference
// it still read back — nothing writes it any more.
enum PaymentMethod {
  CASH
  MPESA
  CARD
  CREDIT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollItemStatus {
  PENDING
  PAID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_REQUIRED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

model User {
  id                 String    @id @default(cuid())
  name               String
  role               Role
  email              String?   @unique
  passwordHash       String?
  pinHash            String?
  avatar             String?
  phone              String?
  permissions        Module[]  @default([])
  maxDiscountPercent Float     @default(0)
  // Separate from module access on purpose (brief: cost/margin permission
  // dimension) — a user can have PRODUCTS/INVENTORY access without seeing
  // acquisition cost or margin figures. Admin always sees cost regardless
  // of this flag (checked via role, never stored redundantly here).
  canViewCost Boolean @default(false)
  // A role, not a hardcoded account — lets whoever holds this flag convert
  // a quote to an invoice (or ring up a POS sale) against stock the system
  // doesn't have recorded, as an explicit backorder promise. Every use is
  // audit-logged with the shortfall.
  canInvoiceWithoutStock Boolean @default(false)
  active             Boolean   @default(true)
  createdById        String?
  createdBy          User?     @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff       User[]    @relation("StaffCreatedBy")
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents             Document[]            @relation("CreatedByUser")
  leadsCreated          Lead[]                @relation("LeadCreatedBy")
  leadsAssigned         Lead[]                @relation("LeadAssignedTo")
  contactsCreated       Contact[]             @relation("ContactCreatedBy")
  priceChanges          ProductPriceHistory[]
  sessions              Session[]
  auditLogs             AuditLog[]
  inventoryReceipts     InventoryReceipt[]
  inventoryMovements    InventoryMovement[]
  customerLedgerEntries CustomerLedgerEntry[]
  employeesCreated      Employee[]
  advancesApproved      EmployeeAdvance[]     @relation("AdvanceApprovedBy")
  advancesCreated       EmployeeAdvance[]     @relation("AdvanceCreatedBy")
  payrollRuns           PayrollRun[]
  expenses              Expense[]
  returns               Return[]

  @@index([role])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Unit {
  id       String    @id @default(cuid())
  name     String    @unique
  symbol   String
  subUnits SubUnit[]
  products Product[]
}

model SubUnit {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  name   String
  factor Float
}

model Product {
  id          String      @id @default(cuid())
  name        String
  displayName String?
  spec        String?
  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  basePrice   Int
  stockStatus StockStatus @default(IN_STOCK)
  active      Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  // Whole units only — PAVA doesn't sell or stock a fraction of a kilo
  // or a fraction of a length — and whole shillings, no cents.
  stockQuantity Int  @default(0)
  lastCost      Int?

  shape       String?
  nominalSize String?
  widthMm     Float?
  heightMm    Float?
  thicknessMm Float?
  gauge       Int?
  material    String? @default("STEEL")

  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id])
  aliases  ProductAlias[]

  items              DocumentItem[]
  returnItems        ReturnItem[]
  priceHistory       ProductPriceHistory[]
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([familyId])
  @@index([shape, nominalSize])
  @@index([gauge])
}

model ProductFamily {
  id       String    @id @default(cuid())
  name     String    @unique
  // When true, the low-stock check sums stockQuantity across every product
  // in the family and compares it to lowStockThreshold (falling back to
  // BusinessSetting.lowStockThreshold when null) instead of checking each
  // product individually — for families like welding rods or binding wire
  // where variants substitute for each other and only the family total
  // matters. Families left false (most steel gauges, where each size
  // genuinely matters) keep the existing per-product check.
  aggregateLowStock Boolean @default(false)
  lowStockThreshold Int?
  products Product[]
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([term])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Int
  newPrice    Int
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  LOSS
  CORRECTION
  OPENING
}

model InventoryReceipt {
  id           String   @id @default(cuid())
  supplier     String
  reference    String?
  notes        String?
  receivedById String
  receivedBy   User     @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  batches InventoryBatch[]

  @@index([receivedAt])
}

model InventoryBatch {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  receiptId         String
  receipt           InventoryReceipt @relation(fields: [receiptId], references: [id])
  quantityReceived  Int
  remainingQuantity Int
  unitCost          Int
  createdAt         DateTime         @default(now())

  movements InventoryMovement[]

  @@index([productId])
  @@index([receiptId])
  @@index([productId, createdAt])
}

model InventoryMovement {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Int
  unitCost    Int?
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([productId])
  @@index([batchId])
  @@index([createdAt])
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  ADJUSTMENT
  OPENING
  REFUND
  WRITE_OFF
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  businessName  String?
  phone         String?
  altPhone      String?
  location      String?
  address       String?
  notes         String?
  isCredit      Boolean  @default(false)
  creditLimit   Int?
  creditBalance Int      @default(0)
  // Soft delete, same convention as Product.active — a customer's documents
  // and ledger history must survive them being archived.
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  documents          Document[]
  ledgerEntries      CustomerLedgerEntry[]
  convertedFromLeads Lead[]

  @@index([active])
}

model CustomerLedgerEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  type        LedgerEntryType
  amount      Int
  documentId  String?
  document    Document?       @relation(fields: [documentId], references: [id])
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([documentId])
}

// Sales pipeline leads — separate from the operational Contact phone book (brief §33)
model Lead {
  id                  String     @id @default(cuid())
  name                String
  company             String?
  phone               String?
  email               String?
  location            String?
  source              String?
  stage               LeadStage  @default(NEW)
  expectedValue       Int?
  notes               String?
  followUpAt          DateTime?
  assignedToId        String?
  assignedTo          User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  convertedCustomerId String?
  convertedCustomer   Customer?  @relation(fields: [convertedCustomerId], references: [id])
  // Soft delete, same convention as Customer/Product — archiving hides a
  // lead from the pipeline without breaking convertedCustomer history.
  active              Boolean    @default(true)
  createdById         String
  createdBy           User       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([stage])
  @@index([assignedToId])
  @@index([active])
}

// Operational phone book: suppliers, drivers, technicians (brief §32)
model Contact {
  id          String    @id @default(cuid())
  name        String
  company     String?
  role        String?
  phone       String?
  altPhone    String?
  notes       String?
  tags        String[]  @default([])
  followUpAt  DateTime?
  // Soft delete, same convention as Customer/Product/Lead.
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("ContactCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([active])
}

// Quote -> Invoice -> Receipt is ONE record; status tracks its lifecycle.
model Document {
  id                 String         @id @default(cuid())
  type               DocumentType
  status             DocumentStatus @default(DRAFT)
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  customerName       String?
  createdById        String
  createdBy          User           @relation("CreatedByUser", fields: [createdById], references: [id])
  transportMode      TransportMode  @default(NONE)
  transportAmount    Int            @default(0)
  roundingAdjustment Int            @default(0)
  paymentMethod      PaymentMethod?
  subtotal           Int            @default(0)
  total              Int            @default(0)
  // Server-side assigned as each stage is reached (brief §53)
  quoteNumber        String?        @unique
  invoiceNumber      String?        @unique
  receiptNumber      String?        @unique
  deliveryNoteNumber String?        @unique
  notes              String?
  createdAt          DateTime       @default(now())
  invoicedAt         DateTime?
  paidAt             DateTime?

  // For a DELIVERY_NOTE only — the invoice or quote it was generated from,
  // so its items/customer/transport are copied (frozen), never live-linked.
  sourceDocumentId String?
  sourceDocument   Document?  @relation("DeliveryNoteSource", fields: [sourceDocumentId], references: [id])
  deliveryNotes    Document[] @relation("DeliveryNoteSource")

  // For a DELIVERY_NOTE only — the dispatch/site address, captured at
  // creation time. Distinct from the customer's stored address: the site
  // goods are dropped at and the customer's billing address aren't always
  // the same. Frozen once the note is created, same immutability rule as
  // every other document field.
  deliveryLocation String?

  // For a DELIVERY_NOTE only — a contact number for whoever's at the drop-off
  // site, since that's often not the customer themselves (a site foreman, a
  // gate guard) and not necessarily the same number on the customer's own
  // record. Same immutability rule as deliveryLocation above.
  deliveryPhone String?

  items         DocumentItem[]
  ledgerEntries CustomerLedgerEntry[]
  returns       Return[]

  @@index([status])
  @@index([createdAt])
}

model DocumentItem {
  id                 String   @id @default(cuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id])
  description        String
  qty                Int
  basePrice          Int      @default(0)
  unitPrice          Int
  discount           Int      @default(0)
  transportAllocated Int      @default(0)
  roundingAdjustment Int      @default(0)
  lineTotal          Int

  returnItems ReturnItem[]

  @@index([documentId])
}

// A return never edits the sale it came from: the original Document stays
// exactly as issued, and each return is its own record referencing the
// document lines it gives back. Several returns can be raised against one
// sale over time; returnable quantity is always (sold - already returned).
model Return {
  id           String         @id @default(cuid())
  returnNumber String         @unique
  documentId   String
  document     Document       @relation(fields: [documentId], references: [id])
  total        Int
  // How the money went back. Null for an account sale, where the refund is
  // posted to the customer's credit ledger instead of paid out at the till.
  refundMethod PaymentMethod?
  reason       String?
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())

  items ReturnItem[]

  @@index([documentId])
  @@index([createdAt])
}

model ReturnItem {
  id             String       @id @default(cuid())
  returnId       String
  return         Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  documentItemId String
  documentItem   DocumentItem @relation(fields: [documentItemId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  description    String
  qty            Int
  unitPrice      Int
  lineTotal      Int

  @@index([returnId])
  @@index([documentItemId])
}

// HR profile (brief §36) — NOT linked to User/login on purpose.
// An employee doesn't need system access to be on payroll.
model Employee {
  id                    String           @id @default(cuid())
  displayName           String
  avatar                String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  jobTitle              String?
  department            String?
  employmentStartDate   DateTime?
  employmentStatus      EmploymentStatus @default(ACTIVE)
  baseSalary            Int              @default(0)
  notes                 String?
  createdById           String
  createdBy             User             @relation(fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  advances     EmployeeAdvance[]
  payrollItems PayrollItem[]

  @@index([employmentStatus])
}

model EmployeeAdvance {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  amount        Int
  date          DateTime      @default(now())
  reason        String?
  status        AdvanceStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?         @relation("AdvanceApprovedBy", fields: [approvedById], references: [id])
  payrollItemId String?
  payrollItem   PayrollItem?  @relation(fields: [payrollItemId], references: [id])
  notes         String?
  createdById   String
  createdBy     User          @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

model PayrollRun {
  id          String        @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  notes       String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  finalizedAt DateTime?
  createdAt   DateTime      @default(now())

  items PayrollItem[]

  @@index([status])
  @@index([periodStart])
}

model PayrollItem {
  id               String            @id @default(cuid())
  payrollRunId     String
  payrollRun       PayrollRun        @relation(fields: [payrollRunId], references: [id])
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id])
  baseSalary       Int
  advancesDeducted Int               @default(0)
  otherDeductions  Int               @default(0)
  adjustments      Int               @default(0)
  grossPay         Int
  netPay           Int
  paymentStatus    PayrollItemStatus @default(PENDING)
  paymentDate      DateTime?
  notes            String?
  createdAt        DateTime          @default(now())

  settledAdvances EmployeeAdvance[]

  @@index([payrollRunId])
  @@index([employeeId])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id            String           @id @default(cuid())
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount        Int
  date          DateTime         @default(now())
  description   String?
  vendor        String?
  paymentMethod PaymentMethod?
  reference     String?
  status        ExpenseStatus    @default(APPROVED)
  notes         String?
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([categoryId])
  @@index([date])
  @@index([status])
}

// Singleton row (id always "singleton") — business identity, document
// numbering prefixes/counters, rounding, low-stock threshold (brief §52).
model BusinessSetting {
  id                String   @id @default("singleton")
  businessName      String   @default("Pava Steel Hardware")
  address           String?
  phone             String?
  email             String?
  quotePrefix       String   @default("QT")
  invoicePrefix     String   @default("INV")
  receiptPrefix     String   @default("RCT")
  deliveryNotePrefix String  @default("DN")
  returnPrefix      String   @default("RTN")
  nextQuoteSeq      Int      @default(1)
  nextInvoiceSeq    Int      @default(1)
  nextReceiptSeq    Int      @default(1)
  nextDeliveryNoteSeq Int    @default(1)
  nextReturnSeq     Int      @default(1)
  roundingIncrement Int      @default(5)
  lowStockThreshold Int      @default(5)
  documentFooter    String?
  // Bank/M-Pesa/till info shown on quotes and invoices so a customer knows
  // how to pay — brief step 6.
  paymentDetails    String?
  updatedAt         DateTime @updatedAt
}
