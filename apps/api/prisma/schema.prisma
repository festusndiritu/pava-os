generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Module {
  DASHBOARD
  POS
  PRODUCTS
  INVENTORY
  CUSTOMERS
  QUOTES
  INVOICES
  CONTACTS
  LEADS
  MARKETING
  HR
  PAYROLL
  EXPENSES
  REPORTS
  ANALYTICS
  AUDIT
  USERS
  SETTINGS
}

enum StockStatus {
  IN_STOCK
  SUPPLIER_ONLY
  OUT_OF_STOCK
}

enum DocumentType {
  QUOTE
  INVOICE
  RECEIPT
}

enum DocumentStatus {
  DRAFT
  QUOTED
  INVOICED
  PAID
  CANCELLED
}

enum TransportMode {
  NONE
  ITEMIZED
  DISTRIBUTED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  CREDIT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollItemStatus {
  PENDING
  PAID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_REQUIRED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

model User {
  id                 String    @id @default(cuid())
  name               String
  role               Role
  email              String?   @unique
  passwordHash       String?
  pinHash            String?
  avatar             String?
  phone              String?
  permissions        Module[]  @default([])
  maxDiscountPercent Float     @default(0)
  active             Boolean   @default(true)
  createdById        String?
  createdBy          User?     @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff       User[]    @relation("StaffCreatedBy")
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents             Document[]            @relation("CreatedByUser")
  leadsCreated          Lead[]                @relation("LeadCreatedBy")
  leadsAssigned         Lead[]                @relation("LeadAssignedTo")
  contactsCreated       Contact[]             @relation("ContactCreatedBy")
  priceChanges          ProductPriceHistory[]
  sessions              Session[]
  auditLogs             AuditLog[]
  inventoryReceipts     InventoryReceipt[]
  inventoryMovements    InventoryMovement[]
  customerLedgerEntries CustomerLedgerEntry[]
  employeesCreated      Employee[]
  advancesApproved      EmployeeAdvance[]     @relation("AdvanceApprovedBy")
  advancesCreated       EmployeeAdvance[]     @relation("AdvanceCreatedBy")
  payrollRuns           PayrollRun[]
  expenses              Expense[]

  @@index([role])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Unit {
  id       String    @id @default(cuid())
  name     String    @unique
  symbol   String
  subUnits SubUnit[]
  products Product[]
}

model SubUnit {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  name   String
  factor Float
}

model Product {
  id          String      @id @default(cuid())
  name        String
  displayName String?
  spec        String?
  imageUrl    String?
  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  basePrice   Float
  stockStatus StockStatus @default(IN_STOCK)
  active      Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  stockQuantity Float  @default(0)
  lastCost      Float?

  shape       String?
  nominalSize String?
  widthMm     Float?
  heightMm    Float?
  thicknessMm Float?
  gauge       Int?
  material    String? @default("STEEL")

  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id])
  aliases  ProductAlias[]

  items              DocumentItem[]
  priceHistory       ProductPriceHistory[]
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([familyId])
  @@index([shape, nominalSize])
  @@index([gauge])
}

model ProductFamily {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([term])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Float
  newPrice    Float
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  LOSS
  CORRECTION
  OPENING
}

model InventoryReceipt {
  id           String   @id @default(cuid())
  supplier     String
  reference    String?
  notes        String?
  receivedById String
  receivedBy   User     @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  batches InventoryBatch[]

  @@index([receivedAt])
}

model InventoryBatch {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  receiptId         String
  receipt           InventoryReceipt @relation(fields: [receiptId], references: [id])
  quantityReceived  Float
  remainingQuantity Float
  unitCost          Float
  createdAt         DateTime         @default(now())

  movements InventoryMovement[]

  @@index([productId])
  @@index([receiptId])
  @@index([productId, createdAt])
}

model InventoryMovement {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Float
  unitCost    Float?
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([productId])
  @@index([batchId])
  @@index([createdAt])
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  ADJUSTMENT
  OPENING
  REFUND
  WRITE_OFF
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  businessName  String?
  phone         String?
  altPhone      String?
  location      String?
  address       String?
  notes         String?
  isCredit      Boolean  @default(false)
  creditLimit   Float?
  creditBalance Float    @default(0)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  documents          Document[]
  ledgerEntries      CustomerLedgerEntry[]
  convertedFromLeads Lead[]
}

model CustomerLedgerEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  type        LedgerEntryType
  amount      Float
  documentId  String?
  document    Document?       @relation(fields: [documentId], references: [id])
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([documentId])
}

// Sales pipeline leads — separate from the operational Contact phone book (brief §33)
model Lead {
  id                  String     @id @default(cuid())
  name                String
  company             String?
  phone               String?
  email               String?
  location            String?
  source              String?
  stage               LeadStage  @default(NEW)
  expectedValue       Float?
  notes               String?
  followUpAt          DateTime?
  assignedToId        String?
  assignedTo          User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  convertedCustomerId String?
  convertedCustomer   Customer?  @relation(fields: [convertedCustomerId], references: [id])
  createdById         String
  createdBy           User       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([stage])
  @@index([assignedToId])
}

// Operational phone book: suppliers, drivers, technicians (brief §32)
model Contact {
  id          String    @id @default(cuid())
  name        String
  company     String?
  role        String?
  phone       String?
  altPhone    String?
  notes       String?
  tags        String[]  @default([])
  followUpAt  DateTime?
  createdById String
  createdBy   User      @relation("ContactCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

// Quote -> Invoice -> Receipt is ONE record; status tracks its lifecycle.
model Document {
  id                 String         @id @default(cuid())
  type               DocumentType
  status             DocumentStatus @default(DRAFT)
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  customerName       String?
  createdById        String
  createdBy          User           @relation("CreatedByUser", fields: [createdById], references: [id])
  transportMode      TransportMode  @default(NONE)
  transportAmount    Float          @default(0)
  roundingAdjustment Float          @default(0)
  paymentMethod      PaymentMethod?
  subtotal           Float          @default(0)
  total              Float          @default(0)
  // Server-side assigned as each stage is reached (brief §53)
  quoteNumber        String?        @unique
  invoiceNumber      String?        @unique
  receiptNumber      String?        @unique
  notes              String?
  createdAt          DateTime       @default(now())
  invoicedAt         DateTime?
  paidAt             DateTime?

  items         DocumentItem[]
  ledgerEntries CustomerLedgerEntry[]

  @@index([status])
  @@index([createdAt])
}

model DocumentItem {
  id                 String   @id @default(cuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id])
  description        String
  qty                Float
  basePrice          Float    @default(0)
  unitPrice          Float
  discount           Float    @default(0)
  transportAllocated Float    @default(0)
  roundingAdjustment Float    @default(0)
  lineTotal          Float

  @@index([documentId])
}

// HR profile (brief §36) — NOT linked to User/login on purpose.
// An employee doesn't need system access to be on payroll.
model Employee {
  id                    String           @id @default(cuid())
  displayName           String
  avatar                String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  jobTitle              String?
  department            String?
  employmentStartDate   DateTime?
  employmentStatus      EmploymentStatus @default(ACTIVE)
  baseSalary            Float            @default(0)
  notes                 String?
  createdById           String
  createdBy             User             @relation(fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  advances     EmployeeAdvance[]
  payrollItems PayrollItem[]

  @@index([employmentStatus])
}

model EmployeeAdvance {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  amount        Float
  date          DateTime      @default(now())
  reason        String?
  status        AdvanceStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?         @relation("AdvanceApprovedBy", fields: [approvedById], references: [id])
  payrollItemId String?
  payrollItem   PayrollItem?  @relation(fields: [payrollItemId], references: [id])
  notes         String?
  createdById   String
  createdBy     User          @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

model PayrollRun {
  id          String        @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  notes       String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  finalizedAt DateTime?
  createdAt   DateTime      @default(now())

  items PayrollItem[]

  @@index([status])
  @@index([periodStart])
}

model PayrollItem {
  id               String            @id @default(cuid())
  payrollRunId     String
  payrollRun       PayrollRun        @relation(fields: [payrollRunId], references: [id])
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id])
  baseSalary       Float
  advancesDeducted Float             @default(0)
  otherDeductions  Float             @default(0)
  adjustments      Float             @default(0)
  grossPay         Float
  netPay           Float
  paymentStatus    PayrollItemStatus @default(PENDING)
  paymentDate      DateTime?
  notes            String?
  createdAt        DateTime          @default(now())

  settledAdvances EmployeeAdvance[]

  @@index([payrollRunId])
  @@index([employeeId])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id            String           @id @default(cuid())
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount        Float
  date          DateTime         @default(now())
  description   String?
  vendor        String?
  paymentMethod PaymentMethod?
  reference     String?
  status        ExpenseStatus    @default(APPROVED)
  notes         String?
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([categoryId])
  @@index([date])
  @@index([status])
}

// Singleton row (id always "singleton") — business identity, document
// numbering prefixes/counters, rounding, low-stock threshold (brief §52).
model BusinessSetting {
  id                String   @id @default("singleton")
  businessName      String   @default("Pava Steel Hardware")
  address           String?
  phone             String?
  email             String?
  quotePrefix       String   @default("QT")
  invoicePrefix     String   @default("INV")
  receiptPrefix     String   @default("RCT")
  nextQuoteSeq      Int      @default(1)
  nextInvoiceSeq    Int      @default(1)
  nextReceiptSeq    Int      @default(1)
  roundingIncrement Float    @default(5)
  lowStockThreshold Float    @default(5)
  documentFooter    String?
  updatedAt         DateTime @updatedAt
}
