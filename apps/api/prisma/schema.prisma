generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Authentication tiers. ADMIN = email/password. STAFF = PIN.
enum Role {
  ADMIN
  STAFF
}

// One entry per sidebar module. Admin can grant any subset of these to a
// staff account. ADMIN role implicitly has every module
enum Module {
  DASHBOARD
  POS
  PRODUCTS
  INVENTORY
  CUSTOMERS
  QUOTES
  INVOICES
  CONTACTS
  LEADS
  MARKETING
  HR
  PAYROLL
  EXPENSES
  REPORTS
  ANALYTICS
  AUDIT
  USERS
  SETTINGS
}

enum StockStatus {
  IN_STOCK
  SUPPLIER_ONLY
  OUT_OF_STOCK
}

enum DocumentType {
  QUOTE
  INVOICE
  RECEIPT
}

enum DocumentStatus {
  DRAFT
  QUOTED
  INVOICED
  PAID
  CANCELLED
}

enum TransportMode {
  NONE
  ITEMIZED
  DISTRIBUTED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  CREDIT
}

model User {
  id           String    @id @default(cuid())
  name         String
  role         Role
  email        String?   @unique
  passwordHash String? // ADMIN only
  pinHash      String? // STAFF only (ADMIN may also keep one as a fallback, but is not required to)
  avatar       String? // key into the frontend's predefined avatar set, e.g. "sky-01"
  phone        String? // optional staff metadata
  permissions  Module[]  @default([]) // ignored for ADMIN, who always has full access
  maxDiscountPercent Float @default(0) // STAFF discount cap, enforced server-side in POS; ignored for ADMIN (unlimited)
  active       Boolean   @default(true)
  createdById  String?
  createdBy    User?     @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff User[]    @relation("StaffCreatedBy")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents    Document[]             @relation("CreatedByUser")
  contacts     Contact[]
  priceChanges ProductPriceHistory[]
  sessions     Session[]
  auditLogs    AuditLog[]
  inventoryReceipts  InventoryReceipt[]
  inventoryMovements InventoryMovement[]
  customerLedgerEntries CustomerLedgerEntry[]

  @@index([role])
}

// One row per issued refresh token. Lets us do sliding-inactivity timeouts
// and *actually* revoke a login (plain JWTs can't be un-issued), without
// making every request hit the DB — only /auth/refresh and /auth/logout do.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime // absolute cap regardless of activity
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // e.g. "auth.login", "user.permissions_changed"
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

// e.g. "Kilogram" (kg), "Piece" (pc), "Length" (m), "Bag" (bag)
model Unit {
  id       String    @id @default(cuid())
  name     String    @unique
  symbol   String
  subUnits SubUnit[]
  products Product[]
}

// e.g. under Unit "Bag": SubUnit "50kg bag" factor 50 (kg per bag)
model SubUnit {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  name   String
  factor Float
}

model Product {
  id          String      @id @default(cuid())
  name        String // technical name, e.g. "SHS 40x40x1.2mm" — never shown to marketing/customers as the only label
  displayName String? // human/customer-facing, e.g. "Square Pipe 1.5\" — 16G". Falls back to `name` when null.
  spec        String? // size / grade, e.g. "Y12", "3mm x 6m", "SHS 50x50x3"
  imageUrl    String? // served from /uploads/products/... — see products.controller.ts
  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  basePrice   Float
  stockStatus StockStatus @default(IN_STOCK)
  active      Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  // Cached projections for fast reads — always written inside the same
  // transaction as the InventoryMovement that changes them (brief §21: the
  // ledger is the source of truth, this is just a denormalized read model).
  stockQuantity Float  @default(0)
  lastCost      Float? // most recent batch's unitCost — used to suggest a new selling price on receiving (brief §23)

  // Structured attributes for search/comparison (brief §7) — deliberately
  // plain fields rather than a generic EAV table: the attribute set is small,
  // known in advance, and needs to be queryable/sortable/comparable directly
  // (e.g. "all 1.5in square pipe sorted by gauge").
  shape       String? // free text for now, e.g. "SQUARE", "ROUND", "FLAT", "ANGLE" — business vocabulary varies too much to lock into an enum yet
  nominalSize String? // e.g. "1.5 inch"
  widthMm     Float?
  heightMm    Float?
  thicknessMm Float? // always stored in mm, even for inch-fraction shapes (angle/flat bar) — see products/shape-config.ts
  gauge       Int? // optional cross-reference tag (e.g. 18 for a 1.0mm tube) — only set where the business actually uses gauge language
  material    String? @default("STEEL")

  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id])
  aliases  ProductAlias[]

  items              DocumentItem[]
  priceHistory       ProductPriceHistory[]
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([familyId])
  @@index([shape, nominalSize])
  @@index([gauge])
}

// Groups technically-distinct products (different gauges/thicknesses of the
// same nominal item) for search/marketing/comparison purposes only — never
// for inventory or pricing. Products stay separate inventory/pricing
// entities regardless of family (brief §10).
model ProductFamily {
  id       String    @id @default(cuid())
  name     String    @unique // e.g. "Square Pipe 1.5\""
  products Product[]
}

// One row per free-text term a product should be found by, e.g. "square
// pipe", "box section", "16 gauge", "40x40" — stored pre-normalized (see
// products/search-normalize.ts) so a normalized incoming query can just
// substring-match against `term` directly.
model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([term])
}

// Audit trail: one row per basePrice change. Past documents never read this —
// they already have their own frozen unitPrice — this is purely "what did we
// list this at, and when, and who changed it" for auditing/trust.
model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Float
  newPrice    Float
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  LOSS
  CORRECTION
  OPENING
}

// One row per delivery from a supplier. Purely a header — the actual
// quantity/cost lives on the InventoryBatch rows it creates.
model InventoryReceipt {
  id           String   @id @default(cuid())
  supplier     String
  reference    String?
  notes        String?
  receivedById String
  receivedBy   User     @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  batches InventoryBatch[]

  @@index([receivedAt])
}

// One row per acquisition cost lot — FIFO consumes these oldest-first
// (brief §20). `remainingQuantity` is decremented as movements consume it;
// `quantityReceived` never changes, so the original receipt is always
// reconstructable even after the batch is fully sold through.
model InventoryBatch {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  receiptId         String
  receipt           InventoryReceipt @relation(fields: [receiptId], references: [id])
  quantityReceived  Float
  remainingQuantity Float
  unitCost          Float
  createdAt         DateTime         @default(now())

  movements InventoryMovement[]

  @@index([productId])
  @@index([receiptId])
  @@index([productId, createdAt]) // FIFO consumption order
}

// The stock ledger (brief §21) — every change in quantity for any reason is
// one row here. Product.stockQuantity is a cached sum of this table, always
// written in the same transaction as the movement that changes it.
model InventoryMovement {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Float // signed: positive = stock in, negative = stock out
  unitCost    Float? // cost basis consumed by this movement, where applicable (SALE/DAMAGE/LOSS draw down a batch's unitCost)
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([productId])
  @@index([batchId])
  @@index([createdAt])
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  ADJUSTMENT
  OPENING
  REFUND
  WRITE_OFF
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  businessName  String?
  phone         String?
  altPhone      String?
  location      String?
  address       String?
  notes         String?
  isCredit      Boolean  @default(false)
  creditLimit   Float?
  creditBalance Float    @default(0) // cached running total — always written alongside a CustomerLedgerEntry, never set directly (brief §26)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  documents     Document[]
  ledgerEntries CustomerLedgerEntry[]
}

// The credit ledger (brief §26) — every change to what a customer owes is
// one row here, explaining itself (invoice, payment, adjustment, opening
// balance, refund, write-off). Customer.creditBalance is a cached sum,
// always updated in the same transaction as the entry that changes it.
model CustomerLedgerEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  type        LedgerEntryType
  amount      Float // signed: +increases balance owed (invoice/opening), -decreases (payment/refund/write-off)
  documentId  String?
  document    Document?       @relation(fields: [documentId], references: [id])
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([documentId])
}

// Marketing guy's contact book
model Contact {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  source      String? // where the lead came from
  notes       String?
  followUpAt  DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
}

// Quote -> Invoice -> Receipt is ONE record; status tracks its lifecycle.
model Document {
  id              String         @id @default(cuid())
  type            DocumentType // reflects current stage, kept for quick display
  status          DocumentStatus @default(DRAFT)
  customerId      String?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  customerName    String? // free-text fallback when no Customer record exists
  createdById     String
  createdBy       User           @relation("CreatedByUser", fields: [createdById], references: [id])
  transportMode   TransportMode  @default(NONE)
  transportAmount Float          @default(0)
  roundingAdjustment Float       @default(0) // sum of per-line commercial rounding, never silently dropped (brief §13)
  paymentMethod   PaymentMethod?
  subtotal        Float          @default(0)
  total           Float          @default(0)
  notes           String?
  createdAt       DateTime       @default(now())
  invoicedAt      DateTime?
  paidAt          DateTime?

  items         DocumentItem[]
  ledgerEntries CustomerLedgerEntry[]

  @@index([status])
  @@index([createdAt])
}

model DocumentItem {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String // snapshot of product name+spec at time of sale
  qty         Float
  basePrice   Float    @default(0) // the "normal" per-unit price before this line's discount — what the receipt shows as struck-through/reference price
  unitPrice   Float // final customer-facing unit price: transport-folded + commercially rounded where applicable
  discount    Float    @default(0)
  transportAllocated Float @default(0) // this line's share of the document's transport charge (brief §18)
  roundingAdjustment Float @default(0) // difference introduced by rounding this line's unit price (brief §13)
  lineTotal   Float

  @@index([documentId])
}
