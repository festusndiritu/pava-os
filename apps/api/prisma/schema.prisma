generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum Module {
  DASHBOARD
  POS
  PRODUCTS
  INVENTORY
  CUSTOMERS
  QUOTES
  INVOICES
  CONTACTS
  LEADS
  MARKETING
  HR
  PAYROLL
  EXPENSES
  REPORTS
  ANALYTICS
  AUDIT
  USERS
  SETTINGS
}

enum StockStatus {
  IN_STOCK
  SUPPLIER_ONLY
  OUT_OF_STOCK
}

enum DocumentType {
  QUOTE
  INVOICE
  RECEIPT
  DELIVERY_NOTE
}

enum DocumentStatus {
  DRAFT
  QUOTED
  INVOICED
  PAID
  CANCELLED
  SUSPENDED
}

enum TransportMode {
  NONE
  ITEMIZED
  DISTRIBUTED
}

// PAVA takes M-Pesa Paybill and cash at the till
enum PaymentMethod {
  CASH
  MPESA
  CREDIT
  // A sale settled with more than one method (e.g. cash + M-Pesa). The split
  // itself lives in DocumentPayment.
  MIXED
  // Paid out of money the customer had already left with the shop (a held
  // balance), not by a new tender. The cash/M-Pesa was counted when it was
  // deposited.
  STORE_CREDIT
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

enum PayrollStatus {
  DRAFT
  FINALIZED
  PAID
}

enum PayrollItemStatus {
  PENDING
  PAID
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  QUOTE_REQUIRED
  QUOTE_SENT
  NEGOTIATING
  WON
  LOST
}

model User {
  id                 String    @id @default(cuid())
  name               String
  role               Role
  email              String?   @unique
  passwordHash       String?
  pinHash            String?
  avatar             String?
  phone              String?
  permissions        Module[]  @default([])
  maxDiscountPercent Float     @default(0)
  canViewCost Boolean @default(false)
  canInvoiceWithoutStock Boolean @default(false)
  active             Boolean   @default(true)
  createdById        String?
  createdBy          User?     @relation("StaffCreatedBy", fields: [createdById], references: [id])
  createdStaff       User[]    @relation("StaffCreatedBy")
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  documents             Document[]            @relation("CreatedByUser")
  leadsCreated          Lead[]                @relation("LeadCreatedBy")
  leadsAssigned         Lead[]                @relation("LeadAssignedTo")
  contactsCreated       Contact[]             @relation("ContactCreatedBy")
  priceChanges          ProductPriceHistory[]
  sessions              Session[]
  auditLogs             AuditLog[]
  inventoryReceipts     InventoryReceipt[]
  inventoryMovements    InventoryMovement[]
  customerLedgerEntries CustomerLedgerEntry[]
  employeesCreated      Employee[]
  advancesApproved      EmployeeAdvance[]     @relation("AdvanceApprovedBy")
  advancesCreated       EmployeeAdvance[]     @relation("AdvanceCreatedBy")
  payrollRuns           PayrollRun[]
  expenses              Expense[]
  returns               Return[]
  editRequested         DocumentEditRequest[] @relation("EditRequestedBy")
  editDecided           DocumentEditRequest[] @relation("EditDecidedBy")
  pushSubscriptions     PushSubscription[]
  followUpDigests       FollowUpDigest[]
  notifications         Notification[]

  @@index([role])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  lastActiveAt     DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Unit {
  id       String    @id @default(cuid())
  name     String    @unique
  symbol   String
  subUnits SubUnit[]
  products Product[]
}

model SubUnit {
  id     String @id @default(cuid())
  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
  name   String
  factor Float
}

model Product {
  id          String      @id @default(cuid())
  name        String
  displayName String?
  spec        String?
  brandId     String?
  brand       Brand?      @relation(fields: [brandId], references: [id])
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  basePrice   Int
  stockStatus StockStatus @default(IN_STOCK)
  active      Boolean     @default(true)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  stockQuantity Int  @default(0)
  lastCost      Int?

  shape       String?
  nominalSize String?
  widthMm     Float?
  heightMm    Float?
  thicknessMm Float?
  gauge       Int?
  material    String? @default("STEEL")

  familyId String?
  family   ProductFamily? @relation(fields: [familyId], references: [id])
  aliases  ProductAlias[]

  items              DocumentItem[]
  returnItems        ReturnItem[]
  priceHistory       ProductPriceHistory[]
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]

  @@index([categoryId])
  @@index([brandId])
  @@index([familyId])
  @@index([shape, nominalSize])
  @@index([gauge])
}

model ProductFamily {
  id       String    @id @default(cuid())
  name     String    @unique
  aggregateLowStock Boolean @default(false)
  lowStockThreshold Int?
  products Product[]
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  term      String
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([term])
}

model ProductPriceHistory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  oldPrice    Int
  newPrice    Int
  changedById String
  changedBy   User     @relation(fields: [changedById], references: [id])
  changedAt   DateTime @default(now())

  @@index([productId])
  @@index([changedAt])
}

enum MovementType {
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  LOSS
  CORRECTION
  OPENING
}

model InventoryReceipt {
  id           String   @id @default(cuid())
  supplier     String
  reference    String?
  notes        String?
  receivedById String
  receivedBy   User     @relation(fields: [receivedById], references: [id])
  receivedAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  batches InventoryBatch[]

  @@index([receivedAt])
}

model InventoryBatch {
  id                String           @id @default(cuid())
  productId         String
  product           Product          @relation(fields: [productId], references: [id])
  receiptId         String
  receipt           InventoryReceipt @relation(fields: [receiptId], references: [id])
  quantityReceived  Int
  remainingQuantity Int
  unitCost          Int
  createdAt         DateTime         @default(now())

  movements InventoryMovement[]

  @@index([productId])
  @@index([receiptId])
  @@index([productId, createdAt])
}

model InventoryMovement {
  id          String          @id @default(cuid())
  productId   String
  product     Product         @relation(fields: [productId], references: [id])
  batchId     String?
  batch       InventoryBatch? @relation(fields: [batchId], references: [id])
  type        MovementType
  quantity    Int
  unitCost    Int?
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([productId])
  @@index([batchId])
  @@index([createdAt])
}

enum LedgerEntryType {
  INVOICE
  PAYMENT
  ADJUSTMENT
  OPENING
  REFUND
  WRITE_OFF
  // Change the customer chose to leave with the shop. Stored as a negative
  // amount: the shop holds the customer's money (credit in their favour).
  CHANGE_DEPOSIT
  // Held credit spent on a later sale. Positive: it shrinks what the shop holds.
  CREDIT_APPLIED
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  businessName  String?
  phone         String?
  altPhone      String?
  location      String?
  address       String?
  notes         String?
  isCredit      Boolean  @default(false)
  creditLimit   Int?
  creditBalance Int      @default(0)
  active        Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  documents          Document[]
  ledgerEntries      CustomerLedgerEntry[]
  convertedFromLeads Lead[]

  @@index([active])
}

model CustomerLedgerEntry {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id])
  type        LedgerEntryType
  amount      Int
  documentId  String?
  document    Document?       @relation(fields: [documentId], references: [id])
  note        String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([customerId])
  @@index([documentId])
}

// Sales pipeline leads — separate from the operational Contact phone book (brief §33)
model Lead {
  id                  String     @id @default(cuid())
  name                String
  company             String?
  phone               String?
  email               String?
  location            String?
  source              String?
  stage               LeadStage  @default(NEW)
  expectedValue       Int?
  notes               String?
  followUpAt          DateTime?
  assignedToId        String?
  assignedTo          User?      @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  convertedCustomerId String?
  convertedCustomer   Customer?  @relation(fields: [convertedCustomerId], references: [id])
  active              Boolean    @default(true)
  createdById         String
  createdBy           User       @relation("LeadCreatedBy", fields: [createdById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([stage])
  @@index([assignedToId])
  @@index([active])
}

// Operational phone book: suppliers, drivers, technicians (brief §32)
model Contact {
  id          String    @id @default(cuid())
  name        String
  company     String?
  role        String?
  phone       String?
  altPhone    String?
  notes       String?
  tags        String[]  @default([])
  followUpAt  DateTime?
  active      Boolean   @default(true)
  createdById String
  createdBy   User      @relation("ContactCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([active])
}

// Quote -> Invoice -> Receipt is ONE record; status tracks its lifecycle.
model Document {
  id                 String         @id @default(cuid())
  type               DocumentType
  status             DocumentStatus @default(DRAFT)
  customerId         String?
  customer           Customer?      @relation(fields: [customerId], references: [id])
  customerName       String?
  createdById        String
  createdBy          User           @relation("CreatedByUser", fields: [createdById], references: [id])
  transportMode      TransportMode  @default(NONE)
  transportAmount    Int            @default(0)
  roundingAdjustment Int            @default(0)
  paymentMethod      PaymentMethod?
  // Change handed back in cash vs. change left with the shop as customer credit.
  changeGiven        Int            @default(0)
  changeToCredit     Int            @default(0)
  // Part of the bill paid from the customer's held credit.
  creditApplied      Int            @default(0)
  // Amount knocked off the whole bill after line prices were agreed; total is already net of it.
  discount           Int            @default(0)
  subtotal           Int            @default(0)
  total              Int            @default(0)
  quoteNumber        String?        @unique
  invoiceNumber      String?        @unique
  receiptNumber      String?        @unique
  deliveryNoteNumber String?        @unique
  notes              String?
  createdAt          DateTime       @default(now())
  invoicedAt         DateTime?
  paidAt             DateTime?
  sourceDocumentId String?
  sourceDocument   Document?  @relation("DeliveryNoteSource", fields: [sourceDocumentId], references: [id])
  deliveryNotes    Document[] @relation("DeliveryNoteSource")
  deliveryLocation String?
  deliveryPhone String?

  items         DocumentItem[]
  payments      DocumentPayment[]
  editRequests  DocumentEditRequest[]
  ledgerEntries CustomerLedgerEntry[]
  returns       Return[]

  @@index([status])
  @@index([createdAt])
  @@index([type, status, createdAt])
  @@index([customerId])
  @@index([status, paidAt])
  @@index([sourceDocumentId])
}

// One row per payment taken against a sale, so a cash + M-Pesa sale keeps both
// halves. `amount` is what was applied to the bill (change already excluded).
model DocumentPayment {
  id         String        @id @default(cuid())
  documentId String
  document   Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  method     PaymentMethod
  amount     Int
  createdAt  DateTime      @default(now())

  @@index([documentId])
}

enum EditRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A staff member's request to correct a completed invoice/receipt. Nothing on
// the document changes until an admin approves; `changes` holds the proposed
// items (with quantities and prices) and transport.
model DocumentEditRequest {
  id           String            @id @default(cuid())
  documentId   String
  document     Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status       EditRequestStatus @default(PENDING)
  reason       String
  changes      Json
  previousTotal Int
  proposedTotal Int
  requestedById String
  requestedBy  User              @relation("EditRequestedBy", fields: [requestedById], references: [id])
  decidedById  String?
  decidedBy    User?             @relation("EditDecidedBy", fields: [decidedById], references: [id])
  decisionNote String?
  createdAt    DateTime          @default(now())
  decidedAt    DateTime?

  @@index([documentId])
  @@index([status])
}

model DocumentItem {
  id                 String   @id @default(cuid())
  documentId         String
  document           Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id])
  description        String
  qty                Int
  basePrice          Int      @default(0)
  unitPrice          Int
  discount           Int      @default(0)
  transportAllocated Int      @default(0)
  roundingAdjustment Int      @default(0)
  lineTotal          Int

  // How much of `qty` physically left the shop's own stock (and so was drawn
  // off FIFO). The rest, qty - stockQty, was supplied from elsewhere (a
  // supplier or another yard) and never touched this shop's inventory. Null
  // means "not recorded": a quote that has not been invoiced yet, or a line
  // from before this existed — both read as "all of it from the shop".
  stockQty       Int?
  // Free-text note of where the non-shop part came from or is collected.
  supplierSource String?

  returnItems ReturnItem[]

  @@index([documentId])
  @@index([productId])
}

model Return {
  id           String         @id @default(cuid())
  returnNumber String         @unique
  documentId   String
  document     Document       @relation(fields: [documentId], references: [id])
  total        Int
  refundMethod PaymentMethod?
  reason       String?
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())

  items ReturnItem[]

  @@index([documentId])
  @@index([createdAt])
}

model ReturnItem {
  id             String       @id @default(cuid())
  returnId       String
  return         Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)
  documentItemId String
  documentItem   DocumentItem @relation(fields: [documentItemId], references: [id])
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id])
  description    String
  qty            Int
  // How many of `qty` went back onto the shelf. A return of goods that were
  // supplied from elsewhere does not add to this shop's stock.
  restockedQty   Int          @default(0)
  unitPrice      Int
  lineTotal      Int

  @@index([returnId])
  @@index([documentItemId])
}

model Employee {
  id                    String           @id @default(cuid())
  displayName           String
  avatar                String?
  phone                 String?
  emergencyContactName  String?
  emergencyContactPhone String?
  jobTitle              String?
  department            String?
  employmentStartDate   DateTime?
  employmentStatus      EmploymentStatus @default(ACTIVE)
  baseSalary            Int              @default(0)
  notes                 String?
  createdById           String
  createdBy             User             @relation(fields: [createdById], references: [id])
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  advances     EmployeeAdvance[]
  payrollItems PayrollItem[]

  @@index([employmentStatus])
}

model EmployeeAdvance {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  amount        Int
  date          DateTime      @default(now())
  reason        String?
  status        AdvanceStatus @default(PENDING)
  approvedById  String?
  approvedBy    User?         @relation("AdvanceApprovedBy", fields: [approvedById], references: [id])
  payrollItemId String?
  payrollItem   PayrollItem?  @relation(fields: [payrollItemId], references: [id])
  notes         String?
  createdById   String
  createdBy     User          @relation("AdvanceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
}

model PayrollRun {
  id          String        @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollStatus @default(DRAFT)
  notes       String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  finalizedAt DateTime?
  createdAt   DateTime      @default(now())

  items PayrollItem[]

  @@index([status])
  @@index([periodStart])
}

model PayrollItem {
  id               String            @id @default(cuid())
  payrollRunId     String
  payrollRun       PayrollRun        @relation(fields: [payrollRunId], references: [id])
  employeeId       String
  employee         Employee          @relation(fields: [employeeId], references: [id])
  baseSalary       Int
  advancesDeducted Int               @default(0)
  otherDeductions  Int               @default(0)
  adjustments      Int               @default(0)
  grossPay         Int
  netPay           Int
  paymentStatus    PayrollItemStatus @default(PENDING)
  paymentDate      DateTime?
  notes            String?
  createdAt        DateTime          @default(now())

  settledAdvances EmployeeAdvance[]

  @@index([payrollRunId])
  @@index([employeeId])
}

model ExpenseCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  expenses Expense[]
}

model Expense {
  id            String           @id @default(cuid())
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount        Int
  date          DateTime         @default(now())
  description   String?
  vendor        String?
  paymentMethod PaymentMethod?
  reference     String?
  status        ExpenseStatus    @default(APPROVED)
  notes         String?
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@index([categoryId])
  @@index([date])
  @@index([status])
}

// numbering prefixes/counters, rounding, low-stock threshold (brief §52).
model BusinessSetting {
  id                String   @id @default("singleton")
  businessName      String   @default("Pava Steel Hardware")
  address           String?
  phone             String?
  email             String?
  quotePrefix       String   @default("QT")
  invoicePrefix     String   @default("INV")
  receiptPrefix     String   @default("RCT")
  deliveryNotePrefix String  @default("DN")
  returnPrefix      String   @default("RTN")
  nextQuoteSeq      Int      @default(1)
  nextInvoiceSeq    Int      @default(1)
  nextReceiptSeq    Int      @default(1)
  nextDeliveryNoteSeq Int    @default(1)
  nextReturnSeq     Int      @default(1)
  roundingIncrement Int      @default(5)
  lowStockThreshold Int      @default(5)
  documentFooter    String?
  paymentDetails    String?
  updatedAt         DateTime @updatedAt
}

// A browser/device a user has agreed to receive push notifications on. One row
// per endpoint (a device + browser profile); the endpoint is unique, so a
// device that a different person logs into is simply re-assigned to them.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

// What the notifications page lists. One row per person it was meant for, so
// each admin reads and clears their own. Push is only the nudge; this is the
// record. `entityType`/`entityId` tie it to the thing waiting (an edit request,
// an advance) so it can be cleared for everyone the moment someone decides it.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String
  url        String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt])
  @@index([entityType, entityId])
}

// One row per user per local day once that day's lead follow-up summary has
// been claimed. The (userId, day) key is what stops a restart, a redeploy or a
// second instance from sending the same morning summary twice.
model FollowUpDigest {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  sentAt DateTime @default(now())

  @@id([userId, day])
}
