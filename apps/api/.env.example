DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pava_hardware?schema=public"
JWT_SECRET="change-me-to-something-long-and-random"
# Access tokens are deliberately short-lived; the frontend transparently
# refreshes them via /auth/refresh as long as the user stays active.
JWT_ACCESS_TOKEN_TTL="15m"
# Inactivity timeouts (minutes) — enforced server-side against Session.lastActiveAt.
ADMIN_INACTIVITY_MINUTES=30
STAFF_INACTIVITY_MINUTES=60
# Absolute session lifetime cap regardless of activity.
SESSION_MAX_HOURS=12
PORT=4000
