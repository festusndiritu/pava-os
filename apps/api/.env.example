DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pava_hardware?schema=public"

JWT_SECRET="change-me-to-something-long-and-random"
JWT_ACCESS_TOKEN_TTL="15m"

# Inactivity timeouts (minutes)
ADMIN_INACTIVITY_MINUTES=30
STAFF_INACTIVITY_MINUTES=60
SESSION_MAX_HOURS=12 # Absolute session lifetime cap regardless of activity.

PORT=4000

# Web Push notifications
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@yourbusiness.co.ke"

# When the daily follow-up summary goes out
REMINDER_HOUR=8
REMINDER_TIMEZONE="Africa/Nairobi"
